<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/NewDeliveryDetailLayout"
    tools:context=".activity.NewDeliveryDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pearl"
    android:padding="10dp">

    <Button
        android:id="@+id/NewDeliveryDetail_createDelivery"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Create Delivery"
        android:textColor="@color/gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/NewDelivery_recyclerViewLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/border_trip_creation"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@+id/NewDeliveryDetail_createDelivery"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/NewDeliveryDetail_textViewParcels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Parcels:"
            android:textColor="@color/gold"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/NewDeliveryDetail_editTextParcel" />

        <EditText
            android:id="@+id/NewDeliveryDetail_editTextParcel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:ems="10"
            android:hint="Enter Item"
            android:inputType="text|textCapCharacters"
            android:textColor="@color/white"
            android:textColorHint="@color/gold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/NewDeliveryDetail_textViewParcels" />

        <Button
            android:id="@+id/NewDeliveryDetail_buttonAddParcel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:backgroundTint="@color/gold"
            android:text="Add"
            android:textColor="@color/theme"
            app:layout_constraintBottom_toBottomOf="@+id/NewDeliveryDetail_editTextParcel"
            app:layout_constraintStart_toEndOf="@+id/NewDeliveryDetail_editTextParcel"
            app:layout_constraintTop_toTopOf="@+id/NewDeliveryDetail_editTextParcel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>